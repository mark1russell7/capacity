{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/capacity",
  "version": "0.1.0",
  "private": true,
  "description": "Performance and capacity models: the cost of one request as laws over each load variable, with intervals.",
  "keywords": [
    "performance",
    "capacity",
    "scaling",
    "model",
    "node",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/capacity#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/capacity/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/capacity.git",
    "directory": "packages/capacity"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fixture.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./schema": {
        "types": "./build/schema.d.ts",
        "default": "./build/schema.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/optional": "^1.2.0",
    "@mark1russell7/quantity": "^0.4.6",
    "@mark1russell7/rigor-bench": "^0.3.3",
    "@mark1russell7/rigor-statistics": "^0.2.18",
    "@mark1russell7/vex": "^0.20.2",
    "@mark1russell7/vex-compiler": "^0.20.2",
    "@mark1russell7/vex-domains": "^0.20.2"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-testkit": "^0.1.20",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.1.0"
  }
}
